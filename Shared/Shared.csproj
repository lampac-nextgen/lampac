<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>library</OutputType>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Prevent SDK implicit glob from colliding with Playwright's buildTransitive LICENSE item -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <!-- Do not set PlaywrightPlatform in a static PropertyGroup: for ProjectReference builds,
       $(RuntimeIdentifier) is often unset at parse time, so "all" blocked Playwright's RID
       logic and pulled every node driver. -->
  <Target Name="LampacPlaywrightPlatformLocalDev" BeforeTargets="CopyPlaywrightFilesToOutput">
    <PropertyGroup>
      <!-- Local `dotnet build`: bundle all drivers.
           Publish/Docker: use -r and Dockerfile passes -p:PlaywrightPlatform
           (RID may not flow to this project). -->
      <PlaywrightPlatform
        Condition="'$(PlaywrightPlatform)' == ''
                                  and '$(RuntimeIdentifier)' == ''
                                  and '$(DeployOnBuild)' != 'true'">
        all</PlaywrightPlatform>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="HtmlKit" />
    <PackageReference Include="Jint" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="MaxMind.GeoIP2" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
		<PrivateAssets>all</PrivateAssets>
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Management" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <PackageReference Include="YoutubeExplode" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>

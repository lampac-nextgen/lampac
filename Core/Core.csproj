<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Core -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>7a9d4585-3e95-4564-a350-5fe756d1351f</UserSecretsId>
    <AssemblyName>Core</AssemblyName>
    <RootNamespace>Core</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Emit Core.exe (Windows) / apphost for publish RID; Docker/Linux can still use `dotnet
    Core.dll`. -->
    <UseAppHost>true</UseAppHost>
    <!-- After publish, move managed dependency DLLs + satellite culture folders into
    runtimes/references (same as lampac). Program.Main preloads that folder. Set false to keep a
    flat publish root. -->
    <LayoutPublishDependenciesInRuntimeReferences
      Condition="'$(LayoutPublishDependenciesInRuntimeReferences)' == ''">true</LayoutPublishDependenciesInRuntimeReferences>
  </PropertyGroup>

  <!-- Playwright drivers: Shared sets `all` only for local `dotnet build`. Publish/Docker: pass
  `-p:PlaywrightPlatform=<RID>` (Dockerfile does). -->

  <ItemGroup>
    <Compile Remove="cache\**" />
    <Compile Remove="database\**" />
    <Content Remove="cache\**" />
    <Content Remove="database\**" />
    <Content Remove="$(NuGetPackageRoot)microsoft.playwright/**" />
    <EmbeddedResource Remove="cache\**" />
    <EmbeddedResource Remove="database\**" />
    <None Remove="cache\**" />
    <None Remove="database\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\bookmarks\img\" />
    <Folder Include="wwwroot\bookmarks\preview\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="plugins\**\*">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Update="plugins\**\*">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Update="data\**\*">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Update="data\**\*">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Modules -->
  <ItemGroup>
    <None Include="..\Modules\**\*"
      Exclude="..\Modules\**\bin\**;..\Modules\**\obj\**;..\Modules\**\Properties\**"
      CopyToPublishDirectory="Always" Visible="false"
      TargetPath="module\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\Modules\GStreamer\gst-libs\win-x86_64\bin\**\*"
      CopyToPublishDirectory="Always" Visible="false"
      TargetPath="module\GStreamer\gst-libs\win-x86_64\bin\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\TestModules\**\*"
      Exclude="..\TestModules\**\bin\**;..\TestModules\**\obj\**;..\TestModules\**\Properties\**"
      CopyToPublishDirectory="Always" Visible="false"
      TargetPath="mods\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\Online\**\*"
      Exclude="..\Online\**\bin\**;..\Online\**\obj\**;..\Online\**\Properties\**"
      CopyToPublishDirectory="Always" Visible="false"
      TargetPath="module\Online\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\SISI\**\*"
      Exclude="..\SISI\**\bin\**;..\SISI\**\obj\**;..\SISI\**\Properties\**"
      CopyToPublishDirectory="Always" Visible="false"
      TargetPath="module\SISI\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\config\**\*"
      Exclude="..\config\**\bin\**;..\config\**\obj\**"
      CopyToPublishDirectory="Always" Visible="false"
      TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Ops fields for GET /version?type=build. Version strings are stamped by
    Directory.Build.targets; this target only adds the metadata ApiController reads.
    With no .git (Docker), dirty stays empty and the endpoint returns null.
  -->
  <Target Name="AddBuildInfoMetadata" DependsOnTargets="GitVersion"
    BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <!-- 0000000 is GitInfo's placeholder when rev-parse fails. -->
      <_LampacSha>$(GitSha.Trim())</_LampacSha>
      <_LampacHasGit
        Condition="'$(_LampacSha.Trim())' != '' and '$(_LampacSha.Trim())' != '0000000'">true</_LampacHasGit>
      <!-- -p:BuildRef, else GITHUB_REF, else the local branch. -->
      <BuildRef Condition="'$(BuildRef)' == ''">$(GITHUB_REF)</BuildRef>
      <BuildRef
        Condition="'$(BuildRef.Trim())' == '' and '$(_LampacHasGit.Trim())' == 'true' and '$(GitBranch.Trim())' != '' and '$(GitBranch.Trim())' != 'HEAD'">
        refs/heads/$(GitBranch)</BuildRef>
      <!-- Actions URL, else the git remote, else Source Link's PrivateRepositoryUrl. -->
      <BuildRepository Condition="'$(BuildRepository)' == '' and '$(GITHUB_REPOSITORY)' != ''">
        $(GITHUB_SERVER_URL)/$(GITHUB_REPOSITORY)</BuildRepository>
      <BuildRepository
        Condition="'$(BuildRepository.Trim())' == '' and '$(_LampacHasGit.Trim())' == 'true' and '$(GitRepositoryUrl)' != ''">
        $(GitRepositoryUrl)</BuildRepository>
      <BuildRepository Condition="'$(BuildRepository.Trim())' == ''">$(PrivateRepositoryUrl)</BuildRepository>
      <BuildRunUrl Condition="'$(GITHUB_RUN_ID)' != ''">
        $(GITHUB_SERVER_URL)/$(GITHUB_REPOSITORY)/actions/runs/$(GITHUB_RUN_ID)</BuildRunUrl>
      <!-- GitIsDirty is 0 when the worktree is clean and 1 when it is not. -->
      <BuildDirty Condition="'$(_LampacHasGit.Trim())' == 'true' and '$(GitIsDirty)' == '0'">false</BuildDirty>
      <BuildDirty Condition="'$(_LampacHasGit.Trim())' == 'true' and '$(GitIsDirty)' == '1'">true</BuildDirty>
      <BuildDate>$([System.DateTime]::UtcNow.ToString('o'))</BuildDate>
      <BuildOs>$([System.Runtime.InteropServices.RuntimeInformation]::OSDescription)</BuildOs>
      <BuildArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</BuildArch>
    </PropertyGroup>
    <!-- CreateProperty drops the newline an XML reformat leaves on the element body. -->
    <CreateProperty Value="$(BuildRef.Trim())">
      <Output TaskParameter="Value" PropertyName="BuildRef" />
    </CreateProperty>
    <CreateProperty Value="$(BuildRepository.Trim())">
      <Output TaskParameter="Value" PropertyName="BuildRepository" />
    </CreateProperty>
    <CreateProperty Value="$(BuildRunUrl.Trim())">
      <Output TaskParameter="Value" PropertyName="BuildRunUrl" />
    </CreateProperty>
    <CreateProperty Value="$(BuildDirty.Trim())">
      <Output TaskParameter="Value" PropertyName="BuildDirty" />
    </CreateProperty>
    <CreateProperty Value="$(BuildDate.Trim())">
      <Output TaskParameter="Value" PropertyName="BuildDate" />
    </CreateProperty>
    <CreateProperty Value="$(BuildOs.Trim())">
      <Output TaskParameter="Value" PropertyName="BuildOs" />
    </CreateProperty>
    <CreateProperty Value="$(BuildArch.Trim())">
      <Output TaskParameter="Value" PropertyName="BuildArch" />
    </CreateProperty>
    <ItemGroup>
      <AssemblyMetadata Include="BuildDirty" Value="$(BuildDirty)" />
      <AssemblyMetadata Include="BuildRef" Value="$(BuildRef)" />
      <AssemblyMetadata Include="BuildRepository" Value="$(BuildRepository)" />
      <AssemblyMetadata Include="BuildRunUrl" Value="$(BuildRunUrl)" />
      <!-- Compile time, not the commit time, so a rebuild of the same commit still changes. -->
      <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
      <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
      <AssemblyMetadata Include="BuildSdk" Value="$(NETCoreSdkVersion)" />
      <AssemblyMetadata Include="BuildOs" Value="$(BuildOs)" />
      <AssemblyMetadata Include="BuildArch" Value="$(BuildArch)" />
    </ItemGroup>
  </Target>

  <!-- Targets -->
  <Target Name="LayoutManagedReferencesInRuntimeFolder" AfterTargets="Publish"
    Condition="'$(LayoutPublishDependenciesInRuntimeReferences)' == 'true'">
    <MakeDir Directories="$(PublishDir)runtimes\references" />
    <ItemGroup>
      <_RefsDlls Include="$(PublishDir)*.dll"
        Exclude="$(PublishDir)Core.dll;$(PublishDir)Shared.dll" />
      <_RefsPdbs Include="$(PublishDir)*.pdb"
        Exclude="$(PublishDir)Core.pdb;$(PublishDir)Shared.pdb" />
    </ItemGroup>
    <Move SourceFiles="@(_RefsDlls)" DestinationFolder="$(PublishDir)runtimes\references"
      Condition="'@(_RefsDlls)' != ''" />
    <Move SourceFiles="@(_RefsPdbs)" DestinationFolder="$(PublishDir)runtimes\references"
      Condition="'@(_RefsPdbs)' != ''" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" WorkingDirectory="$(PublishDir)"
      Command="sh -c 'for d in cs de es fr it ja ko pl pt-BR ru tr zh-Hans zh-Hant; do if [ -d &quot;$d&quot; ]; then rm -rf &quot;runtimes/references/$d&quot;; mv &quot;$d&quot; runtimes/references/; fi; done'" />
    <Exec Condition="'$(OS)' == 'Windows_NT'" WorkingDirectory="$(PublishDir)"
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$c='cs','de','es','fr','it','ja','ko','pl','pt-BR','ru','tr','zh-Hans','zh-Hant'; foreach ($x in $c) { if (Test-Path -LiteralPath $x -PathType Container) { $dest = Join-Path 'runtimes\references' $x; if (Test-Path -LiteralPath $dest) { Remove-Item -LiteralPath $dest -Recurse -Force }; Move-Item -LiteralPath $x -Destination 'runtimes\references\' } }&quot;" />
  </Target>

  <!-- Targets -->
  <Target Name="PrunePublishOutput" AfterTargets="Publish"
    DependsOnTargets="LayoutManagedReferencesInRuntimeFolder">
    <Delete Files="$(PublishDir)Core.pdb" Condition="Exists('$(PublishDir)Core.pdb')" />
    <Delete Files="$(PublishDir)Shared.pdb" Condition="Exists('$(PublishDir)Shared.pdb')" />
    <Delete Files="$(PublishDir)Core.staticwebassets.endpoints.json"
      Condition="Exists('$(PublishDir)Core.staticwebassets.endpoints.json')" />
    <Delete Files="$(PublishDir)playwright.ps1" Condition="Exists('$(PublishDir)playwright.ps1')" />
    <Delete Files="$(PublishDir)runtimes\references\Shared.pdb"
      Condition="Exists('$(PublishDir)runtimes\references\Shared.pdb')" />
  </Target>

</Project>
